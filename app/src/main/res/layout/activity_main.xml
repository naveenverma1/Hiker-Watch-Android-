<?xml version="1.0" encoding="utf-8"?>
<!--
   Hiker's Watch — main screen layout.

   Structure (top-to-bottom):
     1. AppBar with toolbar (provides identity surface + overflow menu).
     2. Scrollable body:
          - Loading row (progress + status text)
          - Warning banner (permission / location-services / coarse-only)
          - Coordinates card
          - Address card
          - Action row (Share / Copy / Open in Maps)
          - Version footer

   The activity applies edge-to-edge insets to the app bar + the scroll view's
   bottom padding so this works correctly under Android 15's enforcement.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back"
    tools:context=".MainActivity">

    <!-- Translucent scrim on top of the hero photo so text/cards stay legible. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:importantForAccessibility="no" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimaryDark"
            app:titleTextColor="@color/textOnPrimary"
            app:subtitleTextColor="@color/textOnPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/contentColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Loading row -->
            <LinearLayout
                android:id="@+id/loadingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_loading" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/status_fetching"
                    android:textColor="@color/textOnPrimary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Warning banner — shown for: permission blocked, location off, coarse-only. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/warningCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/warningBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/warningText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/warningText"
                        android:textSize="14sp"
                        tools:text="Location permission is blocked. Please enable it in Settings." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/warningAction"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/warningText"
                        tools:text="Open Settings" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Coordinates card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/coordsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/surfaceCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.08"
                        android:text="@string/header_coordinates"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/default_latitude"
                        android:textColor="@color/dataLatitude"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/lon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/default_longitude"
                        android:textColor="@color/dataLongitude"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/alt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/default_altitude"
                        android:textColor="@color/dataAltitude"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/acc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/default_accuracy"
                        android:textColor="@color/dataAccuracy"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sensors card: speed / bearing / satellites. All rows auto-hide
                 when there is no signal (e.g. stationary user, no compass
                 sensor, pre-API-24 device). -->
            <androidx.cardview.widget.CardView
                android:id="@+id/sensorsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surfaceCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.08"
                        android:text="@string/header_motion"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/speedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataAccuracy"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Speed: 12.3 km/h" />

                    <TextView
                        android:id="@+id/bearingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataAltitude"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Bearing: 145° SE" />

                    <TextView
                        android:id="@+id/satellitesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawableStart="@drawable/ic_satellite"
                        android:drawablePadding="8dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="14 in fix / 22 in view" />

                    <TextView
                        android:id="@+id/pressureText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataAccuracy"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Pressure: 1013.2 hPa" />

                    <TextView
                        android:id="@+id/baroAltText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataAccuracy"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Baro alt: 245 m" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sky card: sunrise / sunset / solar noon / day length / moon
                 phase. Hidden until we have a fix (lat/lon needed). -->
            <androidx.cardview.widget.CardView
                android:id="@+id/skyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surfaceCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.08"
                        android:text="@string/header_sky"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sunriseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataLatitude"
                        android:textSize="16sp"
                        tools:text="Sunrise:    06:14" />

                    <TextView
                        android:id="@+id/sunsetText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataLongitude"
                        android:textSize="16sp"
                        tools:text="Sunset:     20:42" />

                    <TextView
                        android:id="@+id/solarNoonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataAltitude"
                        android:textSize="14sp"
                        tools:text="Solar noon: 13:28" />

                    <TextView
                        android:id="@+id/dayLengthText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataAccuracy"
                        android:textSize="14sp"
                        tools:text="Day length: 14h 28m" />

                    <TextView
                        android:id="@+id/moonText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        tools:text="Moon: Waxing Gibbous (78% lit)" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Address card (tap to copy) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/addressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_tap_to_copy"
                app:cardBackgroundColor="@color/surfaceCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.08"
                        android:text="@string/header_address"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/default_address"
                        android:textColor="@color/textPrimary"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Target card: shown only when the user opened a geo:lat,lon
                 link from another app. Shows distance + bearing to that
                 target, recomputed as the user moves. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/targetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surfaceCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.08"
                        android:text="@string/header_target"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/targetCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        tools:text="12.971600°, 77.594600°" />

                    <TextView
                        android:id="@+id/targetDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataLatitude"
                        android:textSize="16sp"
                        tools:text="Distance: 4.2 km" />

                    <TextView
                        android:id="@+id/targetBearing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/dataAltitude"
                        android:textSize="16sp"
                        tools:text="Bearing to target: 145° SE" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action row: Share / Copy / Open in Maps -->
            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/action_share"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/action_copy"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMaps"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/action_open_in_maps"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_map" />
            </LinearLayout>

            <!-- Version footer -->
            <TextView
                android:id="@+id/versionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@color/textOnPrimary"
                android:textSize="12sp"
                tools:text="Version 2.2 (4)" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
